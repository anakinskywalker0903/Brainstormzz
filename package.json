{
  "name": "brainstormzz",
  "version": "1.0.0",
  "description": "AI-powered brainstorming whiteboard powered by Chrome's built-in AI",
  "private": true,
  "type": "module",

  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",

    "server": "node server/index.js",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build"
  },

  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.19.2",
    "openai": "^4.56.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1"
  },

  "devDependencies": {
    "autoprefixer": "^10.4.14",
    "gh-pages": "^6.3.0",
    "postcss": "^8.4.24",
    "tailwindcss": "^3.3.0"
  },

  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },

  "keywords": [
    "ai",
    "brainstorming",
    "whiteboard",
    "chrome",
    "local-ai"
  ],

  "author": "Brainstormzz Team",
  "license": "MIT"
}
